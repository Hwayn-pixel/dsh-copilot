{
  "name": "@hwayn/dsh-copilot",
  "version": "0.1.0",
  "description": "A co-pilot for your DSH agent's instructions: read the system prompt as sections, write your own house rules into it, spot what repeats or contradicts, keep a logbook of every change - and roll it all back.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "system-prompt",
    "prompt",
    "instructions",
    "copilot",
    "web-ui"
  ],
  "license": "MIT",
  "author": "Hwayn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hwayn-pixel/dsh-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/Hwayn-pixel/dsh-copilot/issues"
  },
  "homepage": "https://github.com/Hwayn-pixel/dsh-copilot#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "@types/node": "22",
    "@types/react": "~18.3.1",
    "react": "18.2.0"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node build.mjs"
  }
}